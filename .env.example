# Supabase Configuration
# Copy this file to .env.local and fill in your actual Supabase project credentials.
# Found at: https://supabase.com/dashboard -> Your Project -> Settings -> API Keys / Data API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key-here

# Optional: Supabase service role key (server-side only, never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-secret-or-service-role-key-here

# Site URL (update when deploying)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin email (used for display only)
NEXT_PUBLIC_ADMIN_EMAIL=hello@willisotis.dev

